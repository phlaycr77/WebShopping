@model IEnumerable<EcommerceProject.Models.Entities.Category>

@{
    ViewData["Title"] = "Danh sách Danh mục";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark m-0">Danh sách Danh mục</h3>
        <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-primary fw-bold shadow-sm">
            + Thêm danh mục
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;" class="ps-3">ID</th>
                        <th>Tên danh mục</th>
                        <th>Mô tả</th>
                        <th style="width: 160px;" class="text-center pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">@item.Id</td>
                            <td class="fw-semibold">@item.Name</td>
                            <td class="text-secondary">@item.Description</td>
                            <td class="text-center pe-3">
                                <a asp-area="Admin" asp-controller="Category" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm text-dark fw-bold me-1">Sửa</a>
                                <a asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm fw-bold">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>