@model IEnumerable<EcommerceProject.Models.Entities.Order>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<h2>Danh sách Đơn hàng Khách Đặt</h2>

<table class="table table-bordered align-middle mt-3">
    <thead class="table-dark">
        <tr>
            <th>Mã Đơn</th>
            <th>Khách hàng</th>
            <th>Số điện thoại</th>
            <th>Ngày đặt</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>#@item.Id</td>
                <td>@item.CustomerName</td>
                <td>@item.PhoneNumber</td>
                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <span class="badge @(item.Status == "Hoàn thành" ? "bg-success" : item.Status == "Đã hủy" ? "bg-danger" : "bg-warning text-dark")">
                        @item.Status
                    </span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Xem Chi Tiết</a>
                </td>
            </tr>
        }
    </tbody>
</table>