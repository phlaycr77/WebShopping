@model IEnumerable<EcommerceProject.Models.Entities.Product>
@{
    ViewData["Title"] = "Trang chủ";
    var categories = ViewBag.Categories as List<EcommerceProject.Models.Entities.Category>;
    int? selectedCategory = ViewBag.SelectedCategory as int?;
}

<div class="row">
    <!-- Sidebar Danh mục -->
    <div class="col-md-3">
        <h4>Danh mục</h4>
        <div class="list-group">
            <a asp-action="Index" class="list-group-item list-group-item-action @(selectedCategory == null ? "active" : "")">
                Tất cả sản phẩm
            </a>
            @if (categories != null)
            {
                foreach (var cat in categories)
                {
                    <a asp-action="Index" asp-route-categoryId="@cat.Id" 
                       class="list-group-item list-group-item-action @(selectedCategory == cat.Id ? "active" : "")">
                        @cat.Name
                    </a>
                }
            }
        </div>
    </div>

    <!-- Danh sách sản phẩm -->
    <div class="col-md-9">
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/200" : item.ImageUrl)" class="card-img-top" style="height: 200px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text text-danger fw-bold">@item.Price.ToString("N0") VNĐ</p>
                            <div class="mt-auto">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Chi tiết</a>
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <button type="submit" class="btn btn-success btn-sm">Thêm giỏ hàng</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>