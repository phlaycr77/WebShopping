@model EcommerceProject.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Đặt hàng";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <h2>Thông tin giao hàng</h2>
        <form asp-action="Index" method="post">
            <div class="mb-3">
                <label asp-for="CustomerName" class="form-label"></label>
                <input asp-for="CustomerName" class="form-control" />
                <span asp-validation-for="CustomerName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Note" class="form-label"></label>
                <textarea asp-for="Note" class="form-control" rows="3"></textarea>
            </div>
            <button type="submit" class="btn btn-success w-100">Xác nhận đặt hàng</button>
        </form>
    </div>
</div>