@model List<EcommerceProject.Models.ViewModels.CartItemViewModel>
@{
    ViewData["Title"] = "Giỏ hàng";
}

<h2>Giỏ hàng của bạn</h2>

@if (!Model.Any())
{
    <div class="alert alert-warning">Giỏ hàng đang trống. <a asp-controller="Home" asp-action="Index">Mua sắm ngay!</a></div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Price.ToString("N0") VNĐ</td>
                    <td>
                        <form asp-action="UpdateQuantity" method="post" class="d-flex" style="width: 120px;">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm me-1" />
                            <button type="submit" class="btn btn-sm btn-secondary">Đổi</button>
                        </form>
                    </td>
                    <td>@item.Total.ToString("N0") VNĐ</td>
                    <td>
                        <a asp-action="Remove" asp-route-productId="@item.ProductId" class="btn btn-danger btn-sm">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <h4>Tổng cộng: <span class="text-danger">@Model.Sum(x => x.Total).ToString("N0") VNĐ</span></h4>
        <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary btn-lg">Tiến hành đặt hàng</a>
    </div>
}